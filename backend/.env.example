AZURE_B2C_TOKEN_URL=https://your-tenant.b2clogin.com/your-tenant.onmicrosoft.com/your-policy/oauth2/v2.0/token
AZURE_B2C_CLIENT_ID=your-client-id
AZURE_B2C_CLIENT_SECRET=your-client-secret
AZURE_B2C_SCOPE=your-api-scope
AZURE_B2C_RESOURCE=your-api-resource
ENABLE_DIAGNOSTICS=false
PORT=3000

# Supabase PostgreSQL connection (used by Prisma)
# DATABASE_URL: transaction-mode pooler, used by the running application at runtime.
# DIRECT_URL: session-mode pooler, used only by `prisma migrate`.
DATABASE_URL="postgresql://your-user:your-password@your-pooler-host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://your-user:your-password@your-pooler-host:5432/postgres"